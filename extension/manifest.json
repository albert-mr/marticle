{
  "manifest_version": 3,
  "name": "Marticle",
  "version": "1.0.0",
  "description": "Copy X Articles as clean Markdown in one click.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Copy this article as Markdown", "default_popup": "popup.html" }
}
